{
  "keycloak": {
    "issuer": "https://keycloak.example.com/realms/cully",
    "authorization_endpoint": "https://keycloak.example.com/realms/cully/protocol/openid-connect/auth",
    "token_endpoint": "https://keycloak.example.com/realms/cully/protocol/openid-connect/token",
    "jwks_uri": "https://keycloak.example.com/realms/cully/protocol/openid-connect/certs",
    "client_id": "mcp-auth",
    "client_secret_env": "MCP_AUTH_UPSTREAM_CLIENT_SECRET",
    "scopes": ["openid", "profile"],
    "exchange_client_id": "mcp-auth",
    "identity_claims": ["sub"],
    "token_endpoint_auth_method": "client_secret_post",
    "allowed_upstream_callback_uris": ["https://auth.example.com/mcp-auth/identity/callback"],
    "downstream_token_strategy": "upstream_session"
  }
}
