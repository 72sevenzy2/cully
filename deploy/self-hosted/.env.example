# ./setup.sh saves generated database passwords and service tokens in ~/.cully/config.json.
# This file contains only deployment options. Docker Compose reads secrets from setup.sh.
CULLY_MCP_PORT=8080
# OAuth applies only to MCP. Set real values before ./setup.sh --oauth existing|mcp-auth.
CULLY_MCP_HOST=mcp.example.com
CULLY_AUTH_HOST=auth.example.com
CULLY_AUTH_ISSUER=https://auth.example.com/mcp-auth
CULLY_AUTH_RESOURCE=https://mcp.example.com/mcp
CULLY_JWKS_URL=https://auth.example.com/mcp-auth/.well-known/jwks.json
# Required only for the bundled MCP Auth broker with a Keycloak connector.
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
