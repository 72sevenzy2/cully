# Copy to .env, keep it private, replace every example value.
CULLY_DB_NAME=cully
CULLY_DB_USER=cully
CULLY_DB_PASSWORD=replace-with-long-random-password
CULLY_DATABASE_URL=postgres://cully:replace-with-url-encoded-password@db:5432/cully
CULLY_DATA_API_TOKEN=replace-with-long-random-token
CULLY_MCP_OWNER=my-personal-owner
CULLY_MCP_PORT=8080
# Leave Mem0 empty if it has not been deployed. See docs/mem0.md.
CULLY_MEM0_URL=
CULLY_MEM0_API_KEY=

# Required by ./start.sh for the full stack. Use distinct long random values.
CULLY_MEM0_DB_PASSWORD=replace-with-long-random-password
CULLY_MEM0_JWT_SECRET=replace-with-long-random-secret
CULLY_MEM0_OPENAI_API_KEY=replace-with-embedding-provider-key
# Set CULLY_MEM0_API_KEY above to a long random private API key.

# OAuth examples only. Issuer/resource must match public HTTPS routes exactly.
CULLY_MCP_HOST=mcp.example.com
CULLY_AUTH_HOST=auth.example.com
CULLY_AUTH_ISSUER=https://auth.example.com/mcp-auth
CULLY_AUTH_RESOURCE=https://mcp.example.com/mcp
CULLY_JWKS_URL=https://auth.example.com/.well-known/jwks.json
CULLY_CADDYFILE=Caddyfile.existing-auth
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
