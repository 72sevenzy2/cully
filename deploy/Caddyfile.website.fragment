# Add these routes to the existing Docker Caddy configuration.
# Caddy, cully-web and cully-docs must share the workspace_workspace Docker network.
# Preserve the existing workspace, Keycloak and memory service routes.

cully.net {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory
    }
    encode zstd gzip
    reverse_proxy cully-web:8080
}

docs.cully.net {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory
    }
    encode zstd gzip
    reverse_proxy cully-docs:8080
}
