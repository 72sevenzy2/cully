FROM node:24-alpine AS build
WORKDIR /src
COPY site ./site
RUN node site/build.mjs
ARG REVISION=local
RUN printf '{"revision":"%s"}\n' "$REVISION" > dist/site/_deployment.json

FROM nginx:stable-alpine
COPY deploy/nginx.website.conf /etc/nginx/nginx.conf
COPY --from=build /src/dist/site /srv/site
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null --header='Host: cully.net' http://127.0.0.1:8080/
ENTRYPOINT ["nginx", "-g", "daemon off;"]
