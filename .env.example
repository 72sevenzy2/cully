# For an existing Buddy VM, retain its actual database, role and credentials.
CULLY_DB_NAME=buddy
CULLY_DB_USER=buddy
CULLY_DB_PASSWORD=replace-with-existing-database-password
CULLY_DB_VOLUME=replace-with-existing-docker-volume-name
# URL-encode password characters when constructing this URL.
CULLY_DATABASE_URL=postgresql://buddy:replace-with-url-encoded-password@db:5432/buddy
CULLY_DATA_API_TOKEN=replace-with-a-separate-long-random-token
CULLY_DATA_API_URL=https://workspace.mcpruntime.org/cully-data
# Self-hosted Mem0 REST server, reachable from the VM's workspace network.
# Both values are required to enable Mem0. Leave both empty to use FTS only.
CULLY_MEM0_URL=
CULLY_MEM0_API_KEY=
