FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /cully-data ./cmd/cully-data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /cully-data /cully-data
COPY LICENSE NOTICE /licenses/
EXPOSE 8083
ENTRYPOINT ["/cully-data"]
